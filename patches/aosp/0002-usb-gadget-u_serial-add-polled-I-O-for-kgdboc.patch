From 5102a54c7f256f3551b3607dc90bd0c7f1498c4f Mon Sep 17 00:00:00 2001
From: Dom <dominic.ck.wang@protonmail.com>
Date: Sun, 11 Oct 2026 02:20:02 -0400
Subject: [PATCH 2/5] usb: gadget: u_serial: add polled I/O for kgdboc

kgdboc talks to its tty through the poll_init, poll_get_char and
poll_put_char operations, which must work with interrupts off and the
other CPUs stopped. u_serial has none, so a gadget serial port cannot
carry kgdb.

Add them. A port that kgdboc binds gets one IN and one OUT request
reserved for polled use, outside the normal read and write pools. They
are made again in gserial_connect() on every connection, so they
always match the current endpoints and packet size.

A transfer queues its request and then calls usb_gadget_poll() until
the request completes or 250,000 polls pass, at least 250 ms. A
timed-out request stays queued and is waited on again by the next call,
so its completion flag lives in the port, not on the stack, and a byte
is only written into the IN buffer once the previous transfer is done.
If a poll processes a reconnect, which replaces the requests, the
transfer stops without touching the old one.

While the port is disconnected the poll ops keep driving the
controller, so that a reconnect is processed even with the kernel
stopped.
---
 drivers/usb/gadget/function/u_serial.c | 232 +++++++++++++++++++++++++
 1 file changed, 232 insertions(+)

diff --git a/drivers/usb/gadget/function/u_serial.c b/drivers/usb/gadget/function/u_serial.c
index 3b96b5e63..d2eb45890 100644
--- a/drivers/usb/gadget/function/u_serial.c
+++ b/drivers/usb/gadget/function/u_serial.c
@@ -18,6 +18,7 @@
 #include <linux/sched.h>
 #include <linux/device.h>
 #include <linux/delay.h>
+#include <linux/serial_core.h>
 #include <linux/tty.h>
 #include <linux/tty_flip.h>
 #include <linux/slab.h>
@@ -128,6 +129,28 @@ struct gs_port {
 
 	/* REVISIT this state ... */
 	struct usb_cdc_line_coding port_line_coding;	/* 8-N-1 etc */
+
+#ifdef CONFIG_CONSOLE_POLL
+	/*
+	 * Requests for kgdb's polled I/O, kept apart from the normal pools.
+	 * They are made again on every connection, so they always match the
+	 * current endpoints and packet size. The done flags live here, not
+	 * on the stack, because a request that times out stays queued and
+	 * may complete later.
+	 */
+	bool			poll_wanted;	/* kgdboc uses this port */
+	struct usb_gadget	*poll_gadget;
+	struct usb_ep		*poll_tx_ep;	/* IN, phone to host */
+	struct usb_ep		*poll_rx_ep;	/* OUT, host to phone */
+	struct usb_request	*poll_tx;
+	struct usb_request	*poll_rx;
+	volatile int		poll_tx_done;
+	volatile int		poll_rx_done;
+	bool			poll_tx_busy;
+	bool			poll_rx_busy;
+	unsigned int		poll_rx_len;
+	unsigned int		poll_rx_pos;
+#endif
 };
 
 static struct portmaster {
@@ -859,6 +882,207 @@ static int gs_break_ctl(struct tty_struct *tty, int duration)
 	return status;
 }
 
+#ifdef CONFIG_CONSOLE_POLL
+
+/*
+ * Polled I/O for kgdboc. kgdb runs with interrupts off and the other CPUs
+ * stopped, so each transfer is queued and then completed by driving the
+ * controller with usb_gadget_poll() until it finishes or times out.
+ */
+
+#define GS_POLL_TIMEOUT_US	250000
+
+static void gs_poll_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	*(volatile int *)req->context = 1;
+}
+
+/* Called with port_lock held, or from kgdb. */
+static void gs_poll_free(struct gs_port *port)
+{
+	if (port->poll_tx)
+		gs_free_req(port->poll_tx_ep, port->poll_tx);
+	if (port->poll_rx)
+		gs_free_req(port->poll_rx_ep, port->poll_rx);
+	port->poll_tx = NULL;
+	port->poll_rx = NULL;
+}
+
+/* Make the requests for the current connection. Called with port_lock held. */
+static int gs_poll_alloc(struct gs_port *port)
+{
+	struct gserial *gser = port->port_usb;
+
+	gs_poll_free(port);
+	if (!gser || !gser->in || !gser->out || !gser->func.config)
+		return -ENODEV;
+
+	port->poll_tx = gs_alloc_req(gser->in, gser->in->maxpacket, GFP_ATOMIC);
+	port->poll_rx = gs_alloc_req(gser->out, gser->out->maxpacket,
+				     GFP_ATOMIC);
+	if (!port->poll_tx || !port->poll_rx) {
+		if (port->poll_tx)
+			gs_free_req(gser->in, port->poll_tx);
+		if (port->poll_rx)
+			gs_free_req(gser->out, port->poll_rx);
+		port->poll_tx = NULL;
+		port->poll_rx = NULL;
+		return -ENOMEM;
+	}
+
+	port->poll_gadget = gser->func.config->cdev->gadget;
+	port->poll_tx_ep = gser->in;
+	port->poll_rx_ep = gser->out;
+	port->poll_tx_busy = false;
+	port->poll_rx_busy = false;
+	port->poll_rx_len = 0;
+	port->poll_rx_pos = 0;
+	return 0;
+}
+
+/* From gserial_connect(), with port_lock held. */
+static void gs_poll_connect(struct gs_port *port)
+{
+	if (port->poll_wanted && gs_poll_alloc(port))
+		pr_warn("ttyGS%d: no requests for polled I/O\n", port->port_num);
+}
+
+/*
+ * Queue @req unless it is still queued from a timed-out call, then poll
+ * until it completes. Returns the bytes transferred or a negative error.
+ */
+static int gs_poll_xfer(struct gs_port *port, struct usb_ep *ep,
+			struct usb_request *req, volatile int *done,
+			bool *busy)
+{
+	int waited = 0;
+	int status;
+
+	if (!*busy) {
+		*done = 0;
+		req->context = (void *)done;
+		req->complete = gs_poll_complete;
+		status = usb_ep_queue(ep, req, GFP_ATOMIC);
+		if (status)
+			return status;
+		*busy = true;
+	}
+
+	while (!*done && waited++ < GS_POLL_TIMEOUT_US) {
+		if (usb_gadget_poll(port->poll_gadget) == -EOPNOTSUPP)
+			return -EOPNOTSUPP;
+		/* A reconnect handled by the poll replaces the requests. */
+		if (req != port->poll_tx && req != port->poll_rx)
+			return -ESHUTDOWN;
+		udelay(1);
+	}
+
+	if (!*done)
+		return -ETIMEDOUT;
+
+	*busy = false;
+	return req->status ? req->status : (int)req->actual;
+}
+
+static struct gs_port *gs_poll_port(int line)
+{
+	struct gs_port *port;
+
+	if (line < 0 || line >= MAX_U_SERIAL_PORTS)
+		return NULL;
+	port = ports[line].port;
+	if (!port || !port->poll_tx)
+		return NULL;
+
+	/*
+	 * Disconnected: keep the controller running, so that a reconnect
+	 * is processed and gserial_connect() sets the port up again.
+	 */
+	if (!port->port_usb) {
+		usb_gadget_poll(port->poll_gadget);
+		return NULL;
+	}
+	return port;
+}
+
+static int gs_poll_init(struct tty_driver *driver, int line, char *options)
+{
+	struct gs_port *port;
+	unsigned long flags;
+	int status = 0;
+
+	if (line < 0 || line >= MAX_U_SERIAL_PORTS)
+		return -ENODEV;
+	port = ports[line].port;
+	if (!port)
+		return -ENODEV;
+
+	spin_lock_irqsave(&port->port_lock, flags);
+	port->poll_wanted = true;
+	if (!port->poll_tx)
+		status = gs_poll_alloc(port);
+	spin_unlock_irqrestore(&port->port_lock, flags);
+	return status;
+}
+
+static int gs_poll_get_char(struct tty_driver *driver, int line)
+{
+	struct gs_port *port = gs_poll_port(line);
+	struct usb_request *req;
+	u8 *buf;
+	int ret;
+
+	if (!port)
+		return NO_POLL_CHAR;
+
+	req = port->poll_rx;
+	buf = req->buf;
+	if (port->poll_rx_pos < port->poll_rx_len)
+		return buf[port->poll_rx_pos++];
+
+	if (!port->poll_rx_busy)
+		req->length = port->poll_rx_ep->maxpacket;
+	ret = gs_poll_xfer(port, port->poll_rx_ep, req, &port->poll_rx_done,
+			   &port->poll_rx_busy);
+	if (ret <= 0)
+		return NO_POLL_CHAR;
+
+	port->poll_rx_len = ret;
+	port->poll_rx_pos = 1;
+	return buf[0];
+}
+
+static void gs_poll_put_char(struct tty_driver *driver, int line, char ch)
+{
+	struct gs_port *port = gs_poll_port(line);
+	struct usb_request *req;
+
+	if (!port)
+		return;
+	req = port->poll_tx;
+
+	/*
+	 * A request still queued from a timed-out call owns its buffer. Wait
+	 * for it first, and drop this byte if it is still not done.
+	 */
+	if (port->poll_tx_busy &&
+	    gs_poll_xfer(port, port->poll_tx_ep, req, &port->poll_tx_done,
+			 &port->poll_tx_busy) < 0)
+		return;
+	if (req != port->poll_tx)
+		return;
+
+	*(u8 *)req->buf = ch;
+	req->length = 1;
+	gs_poll_xfer(port, port->poll_tx_ep, req, &port->poll_tx_done,
+		     &port->poll_tx_busy);
+}
+
+#else
+static inline void gs_poll_connect(struct gs_port *port) { }
+static inline void gs_poll_free(struct gs_port *port) { }
+#endif /* CONFIG_CONSOLE_POLL */
+
 static const struct tty_operations gs_tty_ops = {
 	.open =			gs_open,
 	.close =		gs_close,
@@ -869,6 +1093,11 @@ static const struct tty_operations gs_tty_ops = {
 	.chars_in_buffer =	gs_chars_in_buffer,
 	.unthrottle =		gs_unthrottle,
 	.break_ctl =		gs_break_ctl,
+#ifdef CONFIG_CONSOLE_POLL
+	.poll_init =		gs_poll_init,
+	.poll_get_char =	gs_poll_get_char,
+	.poll_put_char =	gs_poll_put_char,
+#endif
 };
 
 /*-------------------------------------------------------------------------*/
@@ -1223,6 +1452,7 @@ void gserial_free_line(unsigned char port_num)
 	}
 	port = ports[port_num].port;
 	gs_console_exit(port);
+	gs_poll_free(port);
 	ports[port_num].port = NULL;
 	mutex_unlock(&ports[port_num].lock);
 
@@ -1364,6 +1594,8 @@ int gserial_connect(struct gserial *gser, u8 port_num)
 			gser->disconnect(gser);
 	}
 
+	gs_poll_connect(port);
+
 	status = gs_console_connect(port);
 	spin_unlock_irqrestore(&port->port_lock, flags);
 
-- 
2.53.0

