From be7dc55cca154fa3f215e52c2568be9fab7c09c4 Mon Sep 17 00:00:00 2001
From: Dom <dominic.ck.wang@protonmail.com>
Date: Sun, 11 Oct 2026 02:20:25 -0400
Subject: [PATCH 3/6] usb: gadget: configfs: add a CDC-ACM port for kgdb with
 kgdb_acm

kgdboc needs a USB serial port in the active gadget configuration. On
a production Android build userspace cannot add one: configfs is
root-only and the USB HAL offers no acm function.

With "kgdb_acm" on the kernel command line, add an acm function to
each configuration when configfs binds the gadget, next to whatever
userspace asked for. It is added after usb_gadget_check_config() and
failures only log, so a bind never fails because of it, and adb keeps
working.

On unbind, purge_configs_funcs() would hand every function back to the
configuration's function list, and the next bind would add them all
again before the check. Release the kgdb function there instead, so
that every bind adds it through the same path. The function instance,
and with it the tty line, is created once and kept, and the line is
logged for kgdboc=ttyGS<n>.

Without kgdb_acm on the command line nothing changes.
---
 drivers/usb/gadget/configfs.c | 76 +++++++++++++++++++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/drivers/usb/gadget/configfs.c b/drivers/usb/gadget/configfs.c
index 61815efb0..dffeb22ca 100644
--- a/drivers/usb/gadget/configfs.c
+++ b/drivers/usb/gadget/configfs.c
@@ -9,6 +9,7 @@
 #include "configfs.h"
 #include "u_f.h"
 #include "u_os_desc.h"
+#include "function/u_serial.h"
 
 #ifdef CONFIG_USB_CONFIGFS_UEVENT
 #include <linux/platform_device.h>
@@ -1284,6 +1285,73 @@ int composite_dev_prepare(struct usb_composite_driver *composite,
 int composite_os_desc_req_prepare(struct usb_composite_dev *cdev,
 				  struct usb_ep *ep0);
 
+#if IS_ENABLED(CONFIG_KGDB)
+/*
+ * "kgdb_acm" on the kernel command line adds a CDC-ACM serial function to
+ * every configuration userspace binds, so kgdboc has a USB tty to use.
+ * Android's userspace cannot add one without root.
+ *
+ * It is added after usb_gadget_check_config() and failures only log, so
+ * a bind never fails because of it. On unbind the function is released
+ * rather than handed back to configfs, so every bind adds it the same
+ * way. The function instance, and with it the tty line, is kept.
+ */
+static bool kgdb_acm_enable;
+static struct usb_function_instance *kgdb_acm_fi;
+
+static int __init kgdb_acm_setup(char *str)
+{
+	kgdb_acm_enable = true;
+	return 1;
+}
+__setup("kgdb_acm", kgdb_acm_setup);
+
+static bool kgdb_acm_owns(struct usb_function *f)
+{
+	return kgdb_acm_fi && f->fi == kgdb_acm_fi;
+}
+
+static void kgdb_acm_attach(struct usb_configuration *c)
+{
+	struct f_serial_opts *opts;
+	struct usb_function *f;
+	int ret;
+
+	if (!kgdb_acm_enable)
+		return;
+
+	if (!kgdb_acm_fi) {
+		kgdb_acm_fi = usb_get_function_instance("acm");
+		if (IS_ERR(kgdb_acm_fi)) {
+			pr_warn("kgdb_acm: no acm function (%ld)\n",
+				PTR_ERR(kgdb_acm_fi));
+			kgdb_acm_fi = NULL;
+			return;
+		}
+	}
+
+	f = usb_get_function(kgdb_acm_fi);
+	if (IS_ERR(f)) {
+		pr_warn("kgdb_acm: usb_get_function failed (%ld)\n", PTR_ERR(f));
+		return;
+	}
+
+	ret = usb_add_function(c, f);
+	if (ret) {
+		pr_warn("kgdb_acm: usb_add_function failed (%d)\n", ret);
+		usb_put_function(f);
+		return;
+	}
+
+	opts = container_of(kgdb_acm_fi, struct f_serial_opts, func_inst);
+	pr_info("kgdb_acm: ttyGS%u attached to config %u\n",
+		opts->port_num, c->bConfigurationValue);
+}
+#else
+static inline bool kgdb_acm_owns(struct usb_function *f) { return false; }
+static inline void kgdb_acm_attach(struct usb_configuration *c) { }
+#endif
+
 static void purge_configs_funcs(struct gadget_info *gi)
 {
 	struct usb_configuration	*c;
@@ -1303,6 +1371,11 @@ static void purge_configs_funcs(struct gadget_info *gi)
 					f->name, f);
 				f->unbind(c, f);
 			}
+			if (kgdb_acm_owns(f)) {
+				/* kgdb_acm_attach() adds a new one on bind */
+				list_del(&f->list);
+				usb_put_function(f);
+			}
 		}
 		c->next_interface_id = 0;
 		memset(c->interface, 0, sizeof(c->interface));
@@ -1441,6 +1514,9 @@ static int configfs_composite_bind(struct usb_gadget *gadget,
 		if (ret)
 			goto err_purge_funcs;
 
+		/* after the check, so a failure here cannot fail the bind */
+		kgdb_acm_attach(c);
+
 		usb_ep_autoconfig_reset(cdev->gadget);
 	}
 	if (cdev->use_os_string) {
-- 
2.53.0

