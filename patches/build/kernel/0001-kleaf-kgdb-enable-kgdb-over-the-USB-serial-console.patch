From f08396165f33491b727b8c705c0f73102624da31 Mon Sep 17 00:00:00 2001
From: Dom <dominic.ck.wang@protonmail.com>
Date: Sat, 10 Oct 2026 22:47:02 -0400
Subject: [PATCH] kleaf: kgdb: enable kgdb over the USB serial console

Extend the --kgdb config set so the kernel can run kgdboc on a USB
serial gadget port:

- KGDB_SERIAL_CONSOLE, CONSOLE_POLL, MAGIC_SYSRQ: kgdboc and the
  polled console it talks through.
- U_SERIAL_CONSOLE: console support on the ttyGS* gadget ports.
- PANIC_ON_OOPS off: the GKI defconfig panics on any oops.
- WATCHDOG kept on: the gs101 watchdog drivers depend on it, so the
  watchdogs are stopped at runtime instead.
---
 kleaf/impl/kgdb.bzl | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/kleaf/impl/kgdb.bzl b/kleaf/impl/kgdb.bzl
index ec8dfd5..b078bb3 100644
--- a/kleaf/impl/kgdb.bzl
+++ b/kleaf/impl/kgdb.bzl
@@ -84,11 +84,23 @@ def _get_scripts_config_args(ctx):
             _config.enable("GDB_SCRIPTS"),
             _config.enable("KGDB"),
             _config.enable("KGDB_KDB"),
+            # kgdboc on a polled console. KGDB_SERIAL_CONSOLE selects the
+            # other two; enable them explicitly so .config shows them.
+            _config.enable("KGDB_SERIAL_CONSOLE"),
+            _config.enable("CONSOLE_POLL"),
+            _config.enable("MAGIC_SYSRQ"),
+            # Console on the USB serial gadget (ttyGS*).
+            _config.enable("U_SERIAL_CONSOLE"),
+            # The GKI defconfig panics on any oops; a debug kernel
+            # should stay up so the oops can be inspected.
+            _config.disable("PANIC_ON_OOPS"),
             _config.disable("RANDOMIZE_BASE"),
             _config.disable("STRICT_KERNEL_RWX"),
             _config.enable("VT"),
             _config.disable("VT_CONSOLE"),
-            _config.disable("WATCHDOG"),
+            # The gs101 watchdog drivers depend on CONFIG_WATCHDOG, so
+            # keep it on and stop the watchdogs at runtime instead.
+            _config.enable("WATCHDOG"),
             _config.enable_if("KGDB_LOW_LEVEL_TRAP", condition = "X86"),
         ]
     return struct(
-- 
